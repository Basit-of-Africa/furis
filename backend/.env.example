# Neon: pooled string for the app, direct string for Alembic migrations.
# Use separate Neon branches (main / development) with separate credentials.
FURIS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/furis_db?sslmode=require
FURIS_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/furis_db?sslmode=require

# Contact mailbox sent to OpenAlex/Crossref (polite pool). Use a Research Office address.
FURIS_CONTACT_EMAIL=
FURIS_OPENALEX_API_KEY=

# Fountain University's verified OpenAlex institution ID(s) and ROR ID(s), JSON lists.
FURIS_FU_OPENALEX_INSTITUTION_IDS=[]
FURIS_FU_ROR_IDS=[]

FURIS_MAX_RECORDS_PER_QUERY=1000
# dev_header is for local development only. Replace with SSO before holding real staff data.
FURIS_AUTH_MODE=dev_header
