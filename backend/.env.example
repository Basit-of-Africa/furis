# Neon: pooled string for the app, direct string for Alembic migrations.
# Use separate Neon branches (main / development) with separate credentials.
FURIS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/furis_db?sslmode=require
FURIS_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/furis_db?sslmode=require

# Contact mailbox sent to OpenAlex/Crossref (polite pool). Use a Research Office address.
FURIS_CONTACT_EMAIL=
FURIS_OPENALEX_API_KEY=

# Fountain University's verified OpenAlex institution ID(s) and ROR ID(s), JSON lists.
FURIS_FU_OPENALEX_INSTITUTION_IDS=[]
FURIS_FU_ROR_IDS=[]

FURIS_MAX_RECORDS_PER_QUERY=1000

# development | production. Production refuses to start unless sign-in is oidc.
FURIS_ENVIRONMENT=development

# oidc = university single sign-on; dev_header = email-only dev sign-in (no password).
FURIS_AUTH_MODE=dev_header

# Single sign-on (any OpenID Connect provider). Issuer examples:
#   Google Workspace:   https://accounts.google.com
#   Microsoft Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:           https://sso.example.edu.ng/realms/<realm>
FURIS_OIDC_ISSUER=
FURIS_OIDC_CLIENT_ID=
FURIS_OIDC_ALLOWED_EMAIL_DOMAINS=["fuo.edu.ng"]
# Optional: pin the directory. Google: {"hd":"fuo.edu.ng"}   Entra: {"tid":"<tenant-id>"}
FURIS_OIDC_REQUIRED_CLAIMS={}

# Signs FURIS session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FURIS_SESSION_SECRET=
FURIS_SESSION_TTL_MINUTES=480
