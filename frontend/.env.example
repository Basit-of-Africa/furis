# Where the FURIS FastAPI backend listens. Only the Next.js server calls it; the browser never does.
FURIS_API_URL=http://localhost:8000

# Public address of this portal. Builds the OIDC redirect URI: register
#   ${APP_URL}/auth/callback            as the redirect URI, and
#   ${APP_URL}/login                    as the post-logout redirect URI
# with the university's identity provider.
APP_URL=http://localhost:3000

# Single sign-on (used when the API runs with FURIS_AUTH_MODE=oidc).
# Must match the API's FURIS_OIDC_ISSUER and FURIS_OIDC_CLIENT_ID.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
